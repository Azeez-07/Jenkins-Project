pipeline {
    agent any

    environment {
        IMAGE_NAME = "jenkins-web"
        IMAGE_TAG = "latest"
    }

    stages {

        stage('Clone GitHub Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Azeez-07/Jenkins-Project.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t jenkins:v1
                '''
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    docker images jenkins:v1
                '''
            }
        }
    }

    post {
        success {
            echo 'CI SUCCESS: Docker image built successfully.'
        }

        failure {
            echo 'CI FAILED: Docker image build failed.'
        }
    }
}